{
  "name": "arrows-code-layout",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "arrows-code/libs/layout/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/arrows-code/libs/layout",
        "main": "arrows-code/libs/layout/src/index.ts",
        "tsConfig": "arrows-code/libs/layout/tsconfig.lib.json",
        "assets": ["arrows-code/libs/layout/*.md"],
        "generatePackageJson": true
      }
    },
    "lint": {
      "executor": "@nx/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["arrows-code/libs/layout/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["coverage/arrows-code/libs/layout"],
      "options": {
        "passWithNoTests": true,
        "reportsDirectory": "../../../coverage/arrows-code/libs/layout"
      }
    }
  },
  "tags": ["scope:arrows-code", "type:lib"]
}
