{
  "name": "arrows-code-vscode-arrows",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "arrows-code/apps/vscode-arrows/src",
  "projectType": "application",
  "tags": ["scope:arrows-code", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "arrows-code/apps/vscode-arrows",
        "command": "npm run build"
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "arrows-code/apps/vscode-arrows",
        "command": "npm run package"
      },
      "dependsOn": ["build"]
    },
    "lint": {
      "executor": "@nx/linter:eslint",
      "options": { "lintFilePatterns": ["arrows-code/apps/vscode-arrows/**/*.ts"] }
    }
  }
}
